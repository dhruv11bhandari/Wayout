# Wayout runs entirely locally with everything below unset / false. These variables are
# clean integration points for the two NVIDIA services the architecture is designed for -
# neither is required, and neither is implemented in this prototype (see
# backend/simulation/cuda_engine.py and backend/ai/copilot_provider.py). Flipping either
# ENABLED flag to true without also filling in a real endpoint safely does nothing: the
# app detects that the target is unusable and keeps using the local implementation.

# ---- NVIDIA CUDA (backend/simulation/cuda_engine.py) ------------------------------------
# Would move agent-agent / agent-wall force calculation onto the GPU for very large
# populations or Monte-Carlo scenario sweeps. Not implemented here - LocalSimulationEngine
# (CPU / NumPy) is what actually runs.


CUDA_ENABLED=false

# ---- NVIDIA Nemotron (backend/ai/copilot_provider.py) ------------------------------------
# Would let the copilot answer in natural language instead of the rule-based interpreter,
# while still only narrating numbers the simulator / ML surrogate actually produced (see
# the module docstring in ai/copilot_provider.py for the constraint any implementation
# must satisfy). Not implemented here - FallbackCopilotProvider is what actually answers.


NEMOTRON_ENABLED=false
NEMOTRON_ENDPOINT=
NEMOTRON_MODEL=
NEMOTRON_API_KEY=

# ---- server ---------------------------------------------------------------------------
WAYOUT_HOST=127.0.0.1
WAYOUT_PORT=8000
