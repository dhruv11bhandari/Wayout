# Wayout's demo and evacuation simulation run locally. Uploaded image/PDF floor plans use
# NVIDIA Nemotron 3 Nano Omni for a best-effort geometry draft. Review extracted geometry;
# model output is not certified building data.

# ---- NVIDIA CUDA (backend/simulation/cuda_engine.py) ------------------------------------
# Would move agent-agent / agent-wall force calculation onto the GPU for very large
# populations or Monte-Carlo scenario sweeps. Not implemented here - LocalSimulationEngine
# (CPU / NumPy) is what actually runs.


CUDA_ENABLED=false

# ---- NVIDIA Nemotron floor-plan extraction ----------------------------------------------
# Keep your private key in the ignored project-root .env file. Never commit the key.
# backend/main.py loads that local file when the server starts.


NEMOTRON_ENABLED=false
NEMOTRON_ENDPOINT=
NEMOTRON_MODEL=
NEMOTRON_API_KEY=

# Natural-language copilot integration is still a separate, unimplemented feature.

# ---- server ---------------------------------------------------------------------------
WAYOUT_HOST=127.0.0.1
WAYOUT_PORT=8000
